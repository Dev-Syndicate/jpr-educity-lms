# Copy to .env.local and fill in. .env.local is gitignored.
# Values: Supabase dashboard -> Project Settings -> API keys
#
# Supabase now issues sb_publishable_... / sb_secret_... keys in place of the
# older anon / service_role JWTs. Either format works; the variable names below
# are what the code reads.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (formerly "anon"). Safe in the browser — it can only do what
# row-level security permits.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Secret key (formerly "service_role"). BYPASSES ROW LEVEL SECURITY.
# Server only. Never prefix with NEXT_PUBLIC_ — that inlines it into the
# browser bundle. Read only by lib/supabase/admin.ts, which is `server-only`.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
