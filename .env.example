# Copy to .env.local and fill in. .env.local is gitignored.
# Values come from: Supabase dashboard -> Project Settings -> API
# Or: pnpm dlx supabase projects api-keys --project-ref <ref>

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses row-level security entirely.
# Never prefix with NEXT_PUBLIC_ — that would inline it into the browser bundle.
# Only lib/supabase/admin.ts reads this.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
